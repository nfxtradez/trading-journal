# Copy to .env.local for local use, or add these under Netlify → Site configuration → Environment variables.
# Never commit real values. (.env* files are git-ignored; this example file is the exception.)

# Password for the app's login screen (required on Netlify; leave unset locally for no login).
APP_PASSWORD=

# --- Auto trading ---
# Shared secret that every TradingView alert message must include as "secret".
TV_WEBHOOK_SECRET=

# Tradovate login + API key (Tradovate → Application Settings → API Access).
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_CID=
TRADOVATE_SECRET=
# Optional
# TRADOVATE_APP_ID=TradeLog
# TRADOVATE_APP_VERSION=1.0
# TRADOVATE_DEVICE_ID=

# Live trading stays locked unless this is exactly "true". Even then, switching to live
# needs a typed confirmation in the app, and auto-trading is paused after switching.
# TRADOVATE_ALLOW_LIVE=true
